# Copy to .env (prod) or .env.local (dev). Never commit real secrets.
# Runtime keys (Venice, DeepSeek, Airtable, gen knobs) can also be set in Settings
# and take effect without a redeploy. Settings values override these env vars.
DATABASE_URL=postgres://copy:copy@localhost:5432/copystudio
SESSION_SECRET=change-me-to-a-long-random-string
VENICE_API_KEY=your-venice-key
VENICE_MODEL_ID=venice-uncensored-1-2
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-chat
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Posts
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# ui (default) or rpc (private Flow frontend RPC; requires prior character setup)
FLOW_GENERATION_TRANSPORT=ui
GEN_CHUNK=2
GEN_MAX_TOKENS=2200
GEN_TEMPERATURE=0.9
ADMIN_ACCESS_CODE=set-a-strong-admin-code
MEMBER_ACCESS_CODE=set-a-team-code
